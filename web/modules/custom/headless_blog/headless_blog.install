<?php

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\taxonomy\Entity\Vocabulary;

function headless_blog_install() {
  if (!Vocabulary::load('blog_tags')) {
    Vocabulary::create([
      'vid'  => 'blog_tags',
      'name' => 'Blog Tags',
    ])->save();
  }

  if (!NodeType::load('blog_post')) {
    NodeType::create([
      'type'        => 'blog_post',
      'name'        => 'Blog Post',
      'description' => 'A blog post served via JSON:API.',
    ])->save();
    node_add_body_field(NodeType::load('blog_post'));
  }

  $fields = [
    'field_blog_summary' => [
      'type'  => 'string_long',
      'label' => 'Summary',
    ],
    'field_blog_author' => [
      'type'  => 'string',
      'label' => 'Author',
    ],
    'field_blog_tags' => [
      'type'     => 'entity_reference',
      'label'    => 'Tags',
      'settings' => ['target_type' => 'taxonomy_term'],
    ],
  ];

  foreach ($fields as $field_name => $info) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      $storage = [
        'field_name'  => $field_name,
        'entity_type' => 'node',
        'type'        => $info['type'],
      ];
      if (!empty($info['settings'])) {
        $storage['settings'] = $info['settings'];
      }
      FieldStorageConfig::create($storage)->save();
    }
    if (!FieldConfig::loadByName('node', 'blog_post', $field_name)) {
      FieldConfig::create([
        'field_name'  => $field_name,
        'entity_type' => 'node',
        'bundle'      => 'blog_post',
        'label'       => $info['label'],
      ])->save();
    }
  }
}

function headless_blog_uninstall() {
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'blog_post')
    ->accessCheck(FALSE)
    ->execute();
  if ($nids) {
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $storage->delete($storage->loadMultiple($nids));
  }
  foreach (['field_blog_summary', 'field_blog_author', 'field_blog_tags'] as $f) {
    $field = FieldStorageConfig::loadByName('node', $f);
    if ($field) $field->delete();
  }
  if ($t = NodeType::load('blog_post')) $t->delete();
  if ($v = Vocabulary::load('blog_tags')) $v->delete();
}
